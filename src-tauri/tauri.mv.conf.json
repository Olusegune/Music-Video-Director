{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wheelbarrow Music Video Director",
  "identifier": "ai.wheelbarrow.musicvideodirector",
  "build": {
    "beforeBuildCommand": "npm run build:mv"
  },
  "app": {
    "windows": [
      {
        "title": "Wheelbarrow Music Video Director",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons-mv/32x32.png",
      "icons-mv/128x128.png",
      "icons-mv/128x128@2x.png",
      "icons-mv/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons-mv/icon.ico",
        "headerImage": "icons-mv/installer-header.bmp",
        "sidebarImage": "icons-mv/installer-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "icons-mv/msi-banner.bmp",
        "dialogImagePath": "icons-mv/msi-dialog.bmp"
      }
    }
  }
}
