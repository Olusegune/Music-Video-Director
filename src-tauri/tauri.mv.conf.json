{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wheelbarrow Music Video Director",
  "identifier": "ai.wheelbarrow.musicvideodirector",
  "build": {
    "beforeBuildCommand": "npm run build:mv"
  },
  "app": {
    "windows": [
      {
        "title": "Wheelbarrow Music Video Director",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ]
  }
}
